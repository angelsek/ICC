<header class="kuruf-race-header">
  <img class="kuruf-race-image" src="{{img}}" data-action="editImage" alt="{{localize 'KURUF.RaceCreator.Image'}}">
  <div class="kuruf-race-name form-group">
    <label for="kuruf-name">{{localize "KURUF.RaceCreator.Name"}}</label>
    <input type="text" id="kuruf-name" name="name" required>
  </div>
</header>

<section class="kuruf-race-grid">
  <div class="form-group">
    <label>{{localize "KURUF.RaceCreator.Size"}}</label>
    <select name="size">
      {{selectOptions sizes selected="med"}}
    </select>
  </div>
  <div class="form-group">
    <label>{{localize "KURUF.RaceCreator.CreatureType"}}</label>
    <select name="creatureType">
      {{selectOptions creatureTypes selected="humanoid"}}
    </select>
  </div>
</section>

<fieldset>
  <legend>{{localize "KURUF.RaceCreator.Movement"}}</legend>
  <div class="kuruf-race-grid kuruf-movement-grid">
    <div class="form-group">
      <label>{{localize "KURUF.RaceCreator.MovementWalk"}}</label>
      <input type="number" name="movement.walk" value="30" min="0" step="5">
    </div>
    <div class="form-group">
      <label>{{localize "KURUF.RaceCreator.MovementFly"}}</label>
      <input type="number" name="movement.fly" value="0" min="0" step="5">
    </div>
    <div class="form-group">
      <label>{{localize "KURUF.RaceCreator.MovementSwim"}}</label>
      <input type="number" name="movement.swim" value="0" min="0" step="5">
    </div>
    <div class="form-group">
      <label>{{localize "KURUF.RaceCreator.MovementClimb"}}</label>
      <input type="number" name="movement.climb" value="0" min="0" step="5">
    </div>
    <div class="form-group">
      <label>{{localize "KURUF.RaceCreator.MovementBurrow"}}</label>
      <input type="number" name="movement.burrow" value="0" min="0" step="5">
    </div>
    <div class="form-group">
      <label>{{localize "KURUF.RaceCreator.Units"}}</label>
      <select name="movement.units">
        {{selectOptions movementUnits selected="ft"}}
      </select>
    </div>
  </div>
  <label class="checkbox">
    <input type="checkbox" name="movement.hover">
    {{localize "KURUF.RaceCreator.MovementHover"}}
  </label>
</fieldset>

<fieldset>
  <legend>{{localize "KURUF.RaceCreator.Senses"}}</legend>
  <div class="kuruf-race-grid kuruf-senses-grid">
    <div class="form-group">
      <label>{{localize "KURUF.RaceCreator.SensesDarkvision"}}</label>
      <input type="number" name="senses.darkvision" value="0" min="0" step="5">
    </div>
    <div class="form-group">
      <label>{{localize "KURUF.RaceCreator.SensesBlindsight"}}</label>
      <input type="number" name="senses.blindsight" value="0" min="0" step="5">
    </div>
    <div class="form-group">
      <label>{{localize "KURUF.RaceCreator.SensesTremorsense"}}</label>
      <input type="number" name="senses.tremorsense" value="0" min="0" step="5">
    </div>
    <div class="form-group">
      <label>{{localize "KURUF.RaceCreator.SensesTruesight"}}</label>
      <input type="number" name="senses.truesight" value="0" min="0" step="5">
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "KURUF.RaceCreator.SensesSpecial"}}</label>
    <input type="text" name="senses.special">
  </div>
</fieldset>

<fieldset>
  <legend>{{localize "KURUF.RaceCreator.Description"}}</legend>
  <textarea name="description" rows="4"></textarea>
</fieldset>

<fieldset class="kuruf-traits">
  <legend>{{localize "KURUF.RaceCreator.Traits"}}</legend>
  {{#each traits as |trait index|}}
    <div class="kuruf-trait-row" data-trait-index="{{index}}">
      <input type="text" placeholder="{{localize 'KURUF.RaceCreator.TraitName'}}" value="{{trait.name}}" data-field="name">
      <textarea placeholder="{{localize 'KURUF.RaceCreator.TraitDescription'}}" rows="2" data-field="description">{{trait.description}}</textarea>
      <button type="button" class="kuruf-remove-trait" data-action="removeTrait" data-index="{{index}}" title="{{localize 'KURUF.RaceCreator.RemoveTrait'}}">
        <i class="fa-solid fa-trash"></i>
      </button>
    </div>
  {{/each}}
  <button type="button" data-action="addTrait">
    <i class="fa-solid fa-plus"></i> {{localize "KURUF.RaceCreator.AddTrait"}}
  </button>
</fieldset>

<footer class="form-footer">
  <button type="submit">
    <i class="fa-solid fa-dna"></i> {{localize "KURUF.RaceCreator.Submit"}}
  </button>
</footer>
